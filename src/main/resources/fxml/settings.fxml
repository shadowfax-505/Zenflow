<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.zenflow.controller.SettingsController" spacing="15" alignment="CENTER">
    <children>
        <Label text="Settings" style="-fx-font-size: 22px; -fx-font-weight: bold;" />

        <HBox spacing="10" alignment="CENTER">
            <Label text="Focus Duration (minutes):" />
            <TextField fx:id="focusField" prefWidth="60" text="25"/>
            <Button text="Save" onAction="#onSaveFocusMinutes" />
            <Button text="Reload" onAction="#onReloadFocusMinutes" />
        </HBox>
        <Label fx:id="focusStatus" textFill="green" />

        <Separator />
        <HBox spacing="10" alignment="CENTER">
            <Label text="Whitelist app (choose or type):" />
            <ComboBox fx:id="whitelistCombo" promptText="e.g. Code" prefWidth="220" editable="true" />
            <Button text="Refresh" onAction="#onRefreshWhitelistList" />
            <Button text="Save" onAction="#onSaveWhitelist" />
            <Button text="Remove" onAction="#onRemoveWhitelist" />
        </HBox>
        <Label fx:id="whitelistStatus" textFill="green" />
    </children>
</VBox>
