<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="360" prefWidth="600" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="com.zenflow.controller.TimerController">
    <children>
        <VBox alignment="CENTER" spacing="16.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <Label style="-fx-font-size:20px; -fx-font-weight:bold;" text="ZenFlow" />
            <ProgressBar fx:id="progressBar" prefHeight="24" prefWidth="400" progress="0" />
            <Label fx:id="timeLabel" style="-fx-font-size:28px;" text="25:00" />
            <HBox alignment="CENTER" spacing="12">
                <Button fx:id="startBtn" onAction="#onStart" text="Start" />
                <Button fx:id="pauseBtn" onAction="#onPause" text="Pause" />
                <Button fx:id="stopBtn" onAction="#onStop" text="Stop" />
            </HBox>
            <Label style="-fx-font-size:10px; -fx-text-fill:gray;" />
        </VBox>
    </children>
</AnchorPane>
