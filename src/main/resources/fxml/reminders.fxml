<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.zenflow.controller.RemindersController" spacing="12" alignment="CENTER">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16" />
    </padding>

    <Label text="Reminders" style="-fx-font-size: 22px; -fx-font-weight: bold;" />

    <HBox spacing="12" alignment="CENTER">
        <Label text="Select date:" />
        <DatePicker fx:id="datePicker" />
        <Button text="Reload" onAction="#onReload" />
    </HBox>

    <ListView fx:id="remindersList" prefWidth="720" prefHeight="260" />

    <HBox spacing="10" alignment="CENTER">
        <TextField fx:id="reminderText" promptText="Type a reminder for the selected date" prefWidth="520" />
        <Button text="Add" onAction="#onAdd" />
        <Button text="Delete selected" onAction="#onDeleteSelected" />
    </HBox>

    <Label fx:id="statusLabel" textFill="green" />
</VBox>

